{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "orb",
        "title": "Aura Orb",
        "width": 64,
        "height": 64,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "focus": false,
        "hiddenTitle": true
      },
      {
        "label": "hub",
        "title": "Aura Hub",
        "width": 960,
        "height": 680,
        "alwaysOnTop": false,
        "transparent": false,
        "decorations": true,
        "visible": false
      },
      {
        "label": "permission",
        "title": "Aura Permission",
        "width": 420,
        "height": 300,
        "alwaysOnTop": true,
        "transparent": false,
        "decorations": false,
        "visible": false,
        "resizable": false
      },
      {
        "label": "onboarding",
        "title": "Aura Setup",
        "width": 640,
        "height": 480,
        "alwaysOnTop": false,
        "transparent": false,
        "decorations": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "dev.aura.desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ollama",
      "binaries/aura-core"
    ]
  }
}
